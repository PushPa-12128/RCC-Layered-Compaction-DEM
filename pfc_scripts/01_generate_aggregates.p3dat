; ==============================================================================
; PFC3D 5.0/6.0/7.0 Script: 01_generate_aggregates.p3dat
; 论文复现: 碾压混凝土不规则骨料形状库构建与配合比级配投放
; 配合比参考: 水 (101kg/m3), 水泥 (94.7kg/m3), 粉煤灰 (115.7kg/m3), 砂 (695kg/m3)
;           小石 (701kg/m3, 5-20mm), 中石 (701kg/m3, 20-40mm)
; ==============================================================================

new
model title 'RCC Meso-Structure Aggregate and Mortar Generation'
domain extent -0.2 0.2 -0.1 0.1 -0.05 0.5

; 设置重力加速度
model gravity 0 0 -9.81

; 创建试验槽边界模型 (长 300 mm, 宽 120 mm, 高 500 mm)
wall generate box -0.15 0.15 -0.06 0.06 0.0 0.50 name 'mold_walls'

; ------------------------------------------------------------------------------
; 1. 定义不规则粗骨料 Clump 模板库 (基于三维激光扫描石灰岩点云形态)
; ------------------------------------------------------------------------------
; 模板1: 扁平椭球形多球 Clump
clump template create 'limestone_flaky' ...
    pebble 0 0 0 0.008 ...
    pebble 0.005 0 0 0.006 ...
    pebble -0.005 0 0 0.006 ...
    pebble 0 0.004 0 0.005 ...
    pebble 0 -0.004 0 0.005

; 模板2: 多棱角不规则 Clump
clump template create 'limestone_angular' ...
    pebble 0 0 0 0.009 ...
    pebble 0.006 0.004 0.003 0.005 ...
    pebble -0.006 -0.003 0.002 0.005 ...
    pebble 0.002 -0.005 -0.004 0.005 ...
    pebble -0.003 0.005 0.004 0.004

; 模板3: 块状次棱角 Clump
clump template create 'limestone_blocky' ...
    pebble 0 0 0 0.010 ...
    pebble 0.005 0.005 0.005 0.006 ...
    pebble -0.005 -0.005 -0.005 0.006 ...
    pebble 0.005 -0.005 0 0.005 ...
    pebble -0.005 0.005 0 0.005

; ------------------------------------------------------------------------------
; 2. 赋予基本接触本构模型 (Linear Contact Model)
; ------------------------------------------------------------------------------
cmat default model linear ...
    property kn 1.70e7 ks 1.70e7 dp_nratio 0.2 dp_sratio 0.2 fric 0.8

; ------------------------------------------------------------------------------
; 3. 下层 RCC 颗粒生成与投放 (厚度 170 mm)
; ------------------------------------------------------------------------------
; 砂浆颗粒 (粒径 2mm, 细骨料+胶凝材料统一表征)
ball generate box -0.145 0.145 -0.055 0.055 0.005 0.170 ...
    radius 0.001 0.0012 por 0.42 group 'lower_mortar'

; 粗骨料投放 (中石 20-40mm, 小石 5-20mm)
clump distribute box -0.145 0.145 -0.055 0.055 0.010 0.170 ...
    porosity 0.35 ...
    bin 1 name 'limestone_blocky' volfrac 0.35 size 0.020 0.040 ...
    bin 2 name 'limestone_angular' volfrac 0.35 size 0.010 0.020 ...
    bin 3 name 'limestone_flaky' volfrac 0.30 size 0.005 0.010 ...
    group 'lower_coarse'

; 设置密度
ball property density 2581.0 range group 'lower_mortar'
clump property density 2689.0 range group 'lower_coarse'

model save 'lower_generated.p3sav'
return